# Copy to .env. Docker reads this file literally: keep comments on their own lines,
# and do not quote values.

# OpenRouter key for AI chat. Without it, the app runs and chat says it is not configured.
OPENROUTER_API_KEY=

# Massive (Polygon.io) key for real market data. Empty uses the built-in simulator.
MASSIVE_API_KEY=

# true returns deterministic mock chat replies, with no key and no network (for testing).
LLM_MOCK=false
